# Configuração opcional. Sem estas variáveis, o app usa apenas armazenamento local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional no site: URL fixa da tela /account para confirmação e recuperação por e-mail.
# Cadastre a mesma URL em Supabase Auth > URL Configuration > Redirect URLs.
# Google OAuth web sempre retorna à origem atual para preservar seu verificador PKCE.
EXPO_PUBLIC_AUTH_WEB_REDIRECT_URL=
# Nunca coloque service_role, sb_secret_ ou chave de provedor de IA neste arquivo.
