{
  "expo": {
    "name": "Cortexa",
    "slug": "cortexa",
    "scheme": "cortexa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/cortexa-app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cortexa.study"
    },
    "android": {
      "package": "com.cortexa.study",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/cortexa-app-icon.png",
        "backgroundColor": "#0B13BD"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Cortexa · Seu próximo passo na Medicina"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
